{"kind":"symbol","variants":[{"paths":["\/documentation\/qsobjc\/decodeoptionsobjc\/listlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"c:@M@QsObjC@objc(cs)QsDecodeOptions(py)listLimit","role":"symbol","title":"listLimit","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"listLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"symbolKind":"property","modules":[{"name":"QsObjC"}],"roleHeading":"Instance Property"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/QsObjC\/documentation\/QsObjC\/DecodeOptionsObjC\/listLimit"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/QsObjC\/documentation\/QsObjC","doc:\/\/QsObjC\/documentation\/QsObjC\/DecodeOptionsObjC"]]},"abstract":[{"text":"Maximum list size and numeric-index threshold used while decoding.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The limit is cumulative across duplicate keys, flat comma-separated values, and list"},{"type":"text","text":" "},{"type":"text","text":"merges. A result with exactly "},{"code":"listLimit","type":"codeVoice"},{"type":"text","text":" elements remains a list; growing past it"},{"type":"text","text":" "},{"type":"text","text":"becomes a numeric-keyed dictionary, or throws when "},{"code":"throwOnLimitExceeded","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A negative limit treats every list construction or merge that reaches limit enforcement"},{"type":"text","text":" "},{"type":"text","text":"as exceeded. Parser-recognized empty lists can still be preserved by "},{"type":"codeVoice","code":"allowEmptyLists"},{"type":"text","text":" "},{"type":"text","text":"because they bypass list construction."}]},{"inlineContent":[{"type":"text","text":"Comma values written with "},{"type":"codeVoice","code":"[]="},{"type":"text","text":" are nested groups: each complete comma group counts as"},{"type":"text","text":" "},{"type":"text","text":"one outer list element, regardless of how many values the group contains. Numeric"},{"type":"text","text":" "},{"type":"text","text":"bracket indices at or above the limit are represented as dictionary keys."}],"type":"paragraph"}]}],"sections":[],"references":{"doc://QsObjC/documentation/QsObjC":{"title":"QsObjC","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/qsobjc","kind":"symbol","identifier":"doc:\/\/QsObjC\/documentation\/QsObjC"},"doc://QsObjC/documentation/QsObjC/DecodeOptionsObjC":{"navigatorTitle":[{"text":"DecodeOptionsObjC","kind":"identifier"}],"identifier":"doc:\/\/QsObjC\/documentation\/QsObjC\/DecodeOptionsObjC","abstract":[{"type":"text","text":"Objective-C wrapper for "},{"type":"codeVoice","code":"QsSwift.DecodeOptions"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/qsobjc\/decodeoptionsobjc","title":"DecodeOptionsObjC","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DecodeOptionsObjC","kind":"identifier"}]},"doc://QsObjC/documentation/QsObjC/DecodeOptionsObjC/listLimit":{"kind":"symbol","abstract":[{"text":"Maximum list size and numeric-index threshold used while decoding.","type":"text"}],"type":"topic","url":"\/documentation\/qsobjc\/decodeoptionsobjc\/listlimit","identifier":"doc:\/\/QsObjC\/documentation\/QsObjC\/DecodeOptionsObjC\/listLimit","role":"symbol",