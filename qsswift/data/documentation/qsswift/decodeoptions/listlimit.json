served by "},{"type":"codeVoice","code":"allowEmptyLists"},{"type":"text","text":" because they bypass list construction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Comma values written with "},{"type":"codeVoice","code":"[]="},{"type":"text","text":" are nested groups: each complete group counts"},{"type":"text","text":" "},{"type":"text","text":"as one outer list element. With "},{"type":"codeVoice","code":"throwOnLimitExceeded"},{"type":"text","text":", each group’s inner element"},{"type":"text","text":" "},{"type":"text","text":"count is also checked before splitting; without throwing, oversized groups stay nested."},{"type":"text","text":" "},{"type":"text","text":"Numeric bracket indices at or above the limit are represented as dictionary keys."}]}]}],"variants":[{"paths":["\/documentation\/qsswift\/decodeoptions\/listlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Maximum list size and numeric-index threshold used while decoding."}],"references":{"doc://QsSwift/documentation/QsSwift/DecodeOptions/listLimit":{"identifier":"doc:\/\/QsSwift\/documentation\/QsSwift\/DecodeOptions\/listLimit","title":"listLimit","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Maximum list size and numeric-index threshold used while decoding."}],"url":"\/documentation\/qsswift\/decodeoptions\/listlimit","type":"topic","role":"symbol","kind":"symbol"},"doc://QsSwift/documentation/QsSwift":{"title":"QsSwift","identifier":"doc:\/\/QsSwift\/documentation\/QsSwift","abstract":[],"url":"\/documentation\/qsswift","type":"topic","role":"collection","kind":"symbol"},"doc://QsSwift/documentation/QsSwift/DecodeOptions":{"identifier":"doc:\/\/QsSwift\/documentation\/QsSwift\/DecodeOptions","title":"DecodeOptions","fragments":[{"text":"struct",